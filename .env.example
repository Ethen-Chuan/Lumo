# Optional: enables real DeepSeek calls in this browser-based demo.
# WARNING: VITE_ variables are included in the client bundle. Never put a
# production secret here when deploying the site publicly.
VITE_DEEPSEEK_API_KEY=

# Optional: Supabase URL and public anon key for experimental cloud sync.
# Run supabase/schema.sql first and keep Row Level Security enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
